{
  "name": "dsh-preset-library",
  "version": "0.1.1",
  "description": "Compact, searchable, tag-based agent preset management for DeepSeek Harness",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "check": "npm test && npm run build",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "esbuild": "^0.25.9"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LiweiDonVee/dsh-preset-library.git"
  },
  "homepage": "https://github.com/LiweiDonVee/dsh-preset-library",
  "bugs": {
    "url": "https://github.com/LiweiDonVee/dsh-preset-library/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "presets",
    "tags"
  ]
}
